# Copy this file to .env in the repository root and set your local values.
PORT=3000
API_PORT=3001

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_DATABASE=happykids

# Replace this placeholder with a long, random secret before starting the servers.
JWT_SECRET=replace-with-a-long-random-value

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_BACKEND_URL=http://localhost:3000
VITE_API_BACKUP_URL=http://localhost:3001

# Configure un servidor SMTP para notificaciones de cuenta y recuperación.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
FRONTEND_URL=http://localhost:5173
