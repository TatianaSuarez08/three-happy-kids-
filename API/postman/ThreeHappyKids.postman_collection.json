              "path": ["carrito", ":productId"],
              "variable": [{ "key": "productId", "value": "{{productId}}" }]
            },
            "description": "Requiere JWT."
          }
        },
        {
          "name": "Vaciar carrito",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{apiBase}}/carrito", "host": ["{{apiBase}}"], "path": ["carrito"] },
            "description": "Requiere JWT."
          }
        }
      ]
    }
